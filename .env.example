# Copy to .env and adjust. Never commit a real .env.
# ---------------------------------------------------------------------------
# Secret used to HMAC-tokenize identifiers. If empty, a random secret is generated
# on first start and stored in $FRAUDMESH_DATA_DIR/.token_secret (git-ignored).
FRAUDMESH_TOKEN_SECRET=

# Required as X-Admin-Token for PUT /api/config, PUT /api/policies, POST /api/models/retrain
# and POST /api/demo/reset. Leave empty for open demo mode (a warning is logged).
FRAUDMESH_ADMIN_TOKEN=

# SQLite by default (file in FRAUDMESH_DATA_DIR). PostgreSQL-compatible schema:
# DATABASE_URL=postgresql+psycopg2://fraudmesh_app:<password>@db:5432/fraudmesh
DATABASE_URL=

# Generate synthetic demo data automatically when the database is empty
FRAUDMESH_AUTO_SEED=true

FRAUDMESH_LOG_LEVEL=INFO
FRAUDMESH_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRAUDMESH_RATE_LIMIT_PER_MINUTE=600
FRAUDMESH_KYC_RATE_LIMIT_PER_MINUTE=20
FRAUDMESH_MAX_BATCH_SIZE=500

# KYC media: max upload size in bytes, and whether raw media may be retained (default: never)
FRAUDMESH_KYC_MAX_BYTES=5242880
FRAUDMESH_KYC_RETAIN_MEDIA=false

# Show synthetic demo identifiers (SBI-DEMO-1042, DEVICE-7F21) as labels; real-looking ids are always masked
FRAUDMESH_SHOW_SYNTHETIC_LABELS=true
